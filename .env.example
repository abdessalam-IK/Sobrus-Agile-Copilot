# Copier ce fichier en .env et remplir les valeurs (ne jamais commiter .env).

# Clé API Linear personnelle, en lecture seule (Linear → Settings → Security & access → Personal API keys)
LINEAR_API_KEY=

# Équipes Linear suivies (défaut : les 7 projets)
# LINEAR_TEAMS=SUPP,CEN,PHARM,SMED,SOB,SMARK,POST

# Google Sheet « Taux d'Occupation Sobrus » : relu via la version en ligne, qui le reçoit de son Apps Script
GOOGLE_SHEET_URL=https://sobrus-agile-copilot.vercel.app/api/sheets
GOOGLE_SHEET_TOKEN=

# Heure des postes Sobrus
COPILOT_TZ=UTC

# Optionnel
# PORT=4300
# SYNC_EVERY_MIN=30
